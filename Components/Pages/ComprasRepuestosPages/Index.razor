@page "/ComprasRepuestos/Index"

@rendermode InteractiveServer

@inject ComprasRepuestosServices CompraService

<PageTitle>Index</PageTitle>

@*Encabezado de la consulta de compras de repuestos*@
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center" style="height: 50px;">
            <h5 class="mb-0">Consulta de Compras de Repuestos</h5>

            @*Botón para crear una nueva compra*@
            <a href="/ComprasRepuestos/Create" class="btn btn-primary">
                <i class="bi bi-plus"></i>
                Crear
            </a>
        </div>

        @*Cuerpo de la consulta de compras de repuestos*@
        <div class="card-body">
            <div class="d-flex align-items-center gap-4">
                @*Filtrar por*@
                <div>
                    <label class="form-label"><strong>Filtrar por</strong></label>
                    <select class="form-select" @bind="Filtro">
                        <option value="Id">Id</option>
                        <option value="Factura">N.° de factura</option>
                        <option value="Proveedor">Proveedor</option>
                    </select>
                </div>

                @*Búsqueda*@
                <div>
                    <label class="form-label"><strong>Búsqueda</strong></label>

                    <div class="d-flex gap-2">
                        <input type="text" class="form-control" placeholder="Buscar..." @bind="ValorFiltro" />

                        @*Botón Buscar*@
                        <button class="btn btn-outline-primary" @onclick="Buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            @*Tabla para consultar información de compras de repuestos*@
            <QuickGrid Items="@Compras.AsQueryable()" Class="table table-bordered mt-3 align-middle">
                <PropertyColumn Property="@(c => c.CompraId)" Title="ID" Sortable="true" />
                <PropertyColumn Property="@(c => c.NumeroFactura)" Title="N.° de factura" Sortable="true" />
                <PropertyColumn Property="@(c => DateOnly.FromDateTime(c.Fecha))" Title="Fecha" Sortable="true" />
                <TemplateColumn Title="Proveedor">
                    @context.Proveedor?.Nombre
                </TemplateColumn>
                <TemplateColumn Title="Repuestos">
                    @string.Join(", ", context.Detalles.Select(d => d.Repuesto?.Nombre))
                </TemplateColumn>
                <PropertyColumn Property="@(c => c.Observacion)" Title="Observación" Sortable="true" />
                <PropertyColumn Property="@(c => c.Total)" Title="Total" Sortable="true" />

                @*Opciones*@
                <TemplateColumn Title="Opciones">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-info"
                                data-bs-toggle="modal" data-bs-target="#consultarModal-@context.CompraId">
                            <i class="bi bi-eye"></i>
                            Consultar
                        </button>
                        <a href="@($"/ComprasRepuestos/Edit/{context.CompraId}")" class="btn btn-warning">Editar</a>
                    </div>

                    @*Modal de consulta de la compra*@
                    <div class="modal fade" id="consultarModal-@context.CompraId" tabindex="-1" role="dialog"
                         aria-labelledby="consultarModalLabel-@context.CompraId" aria-hidden="true">
                        <div class="modal-dialog modal-lg" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="consultarModalLabel-@context.CompraId">Consultar Compra</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div>
                                        <p class="mb-2"><strong>Proveedor:</strong> @(context.Proveedor?.Nombre)</p>
                                        <p class="mb-2"><strong>Factura:</strong> @context.NumeroFactura</p>
                                        <p class="mb-2"><strong>Fecha:</strong> @DateOnly.FromDateTime(context.Fecha)</p>
                                        <p class="mb-2"><strong>Observación:</strong> @(string.IsNullOrWhiteSpace(context.Observacion) ? "Sin observación" : context.Observacion)</p>
                                    </div>

                                    <hr />
                                    <h6>Repuestos de la compra</h6>
                                    @foreach (var detalle in context.Detalles)
                                    {
                                        <div class="d-flex align-items-center gap-3 border-bottom py-2">
                                            @if (!string.IsNullOrWhiteSpace(detalle.Repuesto?.Imagen))
                                            {
                                                <img src="@detalle.Repuesto.Imagen" alt="Imagen de @detalle.Repuesto.Nombre"
                                                     class="rounded" style="width: 48px; height: 48px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="border rounded bg-light d-flex align-items-center justify-content-center"
                                                     style="width: 48px; height: 48px;">
                                                    <i class="bi bi-image text-secondary"></i>
                                                </div>
                                            }
                                            <div class="flex-fill">
                                                <strong>@(detalle.Repuesto?.Nombre)</strong>
                                                <div>REP-@detalle.RepuestoId.ToString("D3")</div>
                                                <div>Cantidad: @detalle.Cantidad</div>
                                                <div>Precio: RD$ @detalle.Precio.ToString("N2")</div>
                                                <strong>RD$ @((detalle.Cantidad * detalle.Precio).ToString("N2"))</strong>
                                            </div>
                                        </div>
                                    }

                                    <div class="d-flex justify-content-end mt-3">
                                        <strong>Total: RD$ @context.Total.ToString("N2")</strong>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        Cerrar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>

        @*Footer*@
        <div class="card-footer">
            <p class="mb-0"><strong>Cantidad: </strong>@Compras.Count</p>
        </div>
    </div>
</div>

@code
{
    public List<ComprasRepuestos> Compras { get; set; } = new();

    public string Filtro = "Id";
    public string ValorFiltro = "";

    protected override async Task OnInitializedAsync()
    {
        Compras = (await CompraService.GetList(c => true)).Value;
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Id" && int.TryParse(ValorFiltro, out int compraId))
            {
                Compras = (await CompraService.GetList(c => c.CompraId == compraId)).Value;
            }
            else if (Filtro == "Factura")
            {
                Compras = (await CompraService.GetList(c =>
                    c.NumeroFactura.ToLower().Contains(ValorFiltro.ToLower()))).Value;
            }
            else if (Filtro == "Proveedor")
            {
                Compras = (await CompraService.GetList(c =>
                    c.Proveedor != null && c.Proveedor.Nombre.ToLower().Contains(ValorFiltro.ToLower()))).Value;
            }
        }
        else
        {
            Compras = (await CompraService.GetList(c => true)).Value;
        }
    }
}
