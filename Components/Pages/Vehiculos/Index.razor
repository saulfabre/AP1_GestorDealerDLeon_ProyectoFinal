@page "/Vehiculos/Index"
@using System.Globalization
@using System.Linq.Expressions

@rendermode InteractiveServer

@inject VehiculosServices VehiculoService

<PageTitle>Vehículos</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <h5 class="mb-0">Consulta de Vehículos</h5>
            <a href="/Vehiculos/Create" class="btn btn-primary">
                <i class="bi bi-plus"></i>
                Crear
            </a>
        </div>

        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="alert alert-danger" role="alert">@Mensaje</div>
            }

            <div class="d-flex flex-wrap align-items-end gap-3">
                <div class="d-flex flex-column flex-fill" style="min-width: 12rem;">
                    <label for="filtro" class="form-label"><strong>Filtrar por</strong></label>
                    <select id="filtro" class="form-select" @bind="Filtro" @bind:after="LimpiarValorFiltro">
                        <option value="Matricula">Matrícula</option>
                        <option value="Marca">Marca</option>
                        <option value="Modelo">Modelo</option>
                        <option value="Ano">Año</option>
                        <option value="Color">Color</option>
                        <option value="Tipo">Tipo</option>
                        <option value="Combustible">Combustible</option>
                        <option value="Transmision">Transmisión</option>
                        <option value="PrecioMaximo">Precio máximo</option>
                    </select>
                </div>
                <div class="d-flex flex-column flex-fill" style="min-width: 12rem;">
                    <label for="estado" class="form-label"><strong>Estado</strong></label>
                    <select id="estado" class="form-select" @bind="EstadoFiltro">
                        <option value="">Todos</option>
                        <option value="Disponible">Disponible</option>
                        <option value="Reservado">Reservado</option>
                        <option value="Inactivo">Inactivo</option>
                        <option value="Vendido">Vendido</option>
                    </select>
                </div>
                <div class="d-flex flex-column flex-fill" style="min-width: 12rem;">
                    <label for="anoDesde" class="form-label"><strong>Año desde</strong></label>
                    <select id="anoDesde" class="form-select" @bind="AnoDesde">
                        <option value="">Todos</option>
                        @foreach (var ano in AnosDisponibles)
                        {
                            <option value="@ano">@ano</option>
                        }
                    </select>
                </div>
                <div class="d-flex flex-column flex-fill" style="min-width: 12rem;">
                    <label for="anoHasta" class="form-label"><strong>Año hasta</strong></label>
                    <select id="anoHasta" class="form-select" @bind="AnoHasta">
                        <option value="">Todos</option>
                        @foreach (var ano in AnosDisponibles)
                        {
                            <option value="@ano">@ano</option>
                        }
                    </select>
                </div>
                <div class="d-flex flex-column flex-fill" style="min-width: 16rem;">
                    <label for="busqueda" class="form-label"><strong>Búsqueda</strong></label>
                    <select id="busqueda" class="form-select" @bind="ValorFiltro">
                        <option value="">Todos</option>
                        @foreach (var valor in ValoresDisponibles)
                        {
                            <option value="@valor">@valor</option>
                        }
                    </select>
                </div>
                <div class="w-100 d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-primary me-2" @onclick="Buscar">
                        Buscar
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar">
                        Restablecer
                    </button>
                </div>
            </div>

            @if (Vehiculos.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle"></i>
                    No hay vehículos que coincidan con el filtro.
                </div>
            }

            <div class="table-responsive">
                <QuickGrid Items="@Vehiculos.AsQueryable()" Class="table table-bordered align-middle">
                    <PropertyColumn Property="@(v => v.VehiculoId)" Title="ID" Sortable="true" />
                    <PropertyColumn Property="@(v => v.Modelo!.Marca)" Title="Marca" Sortable="true" />
                    <PropertyColumn Property="@(v => v.Modelo!.Nombre)" Title="Modelo" Sortable="true" />
                    <PropertyColumn Property="@(v => v.Ano)" Title="Año" Sortable="true" />
                    <PropertyColumn Property="@(v => v.Matricula)" Title="Matrícula" Sortable="true" />
                    <PropertyColumn Property="@(v => v.Precio)" Title="Precio" Format="N2" Sortable="true" />
                    <PropertyColumn Property="@(v => v.Kilometraje)" Title="Kilometraje" Format="N0" Sortable="true" />
                    <PropertyColumn Property="@(v => v.Tipo)" Title="Tipo" Sortable="true" />
                    <PropertyColumn Property="@(v => v.Combustible)" Title="Combustible" Sortable="true" />
                    <PropertyColumn Property="@(v => v.Transmision)" Title="Transmisión" Sortable="true" />
                    <TemplateColumn Title="Estado">
                        <span class="badge @EstadoClase(context.Estado)">
                            @context.Estado
                        </span>
                    </TemplateColumn>
                    <TemplateColumn Title="Acciones">
                        <div class="d-flex gap-2">
                            <a href="@($"/Vehiculos/Edit/{context.VehiculoId}")" class="btn btn-warning">
                                Editar
                            </a>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>

        <div class="card-footer d-flex flex-wrap gap-4">
            <span><strong>Total:</strong> @Vehiculos.Count</span>
            <span><strong>Disponibles:</strong> @Vehiculos.Count(v => v.Estado == "Disponible")</span>
            <span><strong>Vendidos:</strong> @Vehiculos.Count(v => v.Estado == "Vendido")</span>
        </div>
    </div>
</div>

@code {
    private List<Vehiculos> Vehiculos { get; set; } = new();
    private List<Vehiculos> VehiculosDisponibles { get; set; } = new();
    private string Filtro { get; set; } = "Matricula";
    private string EstadoFiltro { get; set; } = "";
    private string ValorFiltro { get; set; } = "";
    private int? AnoDesde { get; set; }
    private int? AnoHasta { get; set; }
    private string? Mensaje { get; set; }
    private IEnumerable<int> AnosDisponibles =>
        VehiculosDisponibles.Select(v => v.Ano).Distinct().OrderByDescending(ano => ano);
    private IEnumerable<string> ValoresDisponibles => Filtro switch
    {
        "Matricula" => VehiculosDisponibles.Select(v => v.Matricula).Distinct().OrderBy(valor => valor),
        "Marca" => VehiculosDisponibles.Where(v => v.Modelo != null)
            .Select(v => v.Modelo!.Marca).Distinct().OrderBy(valor => valor),
        "Modelo" => VehiculosDisponibles.Where(v => v.Modelo != null)
            .Select(v => v.Modelo!.Nombre).Distinct().OrderBy(valor => valor),
        "Ano" => AnosDisponibles.Select(ano => ano.ToString(CultureInfo.InvariantCulture)),
        "Color" => VehiculosDisponibles.Select(v => v.Color).Distinct().OrderBy(valor => valor),
        "Tipo" => VehiculosDisponibles.Select(v => v.Tipo).Distinct().OrderBy(valor => valor),
        "Combustible" => VehiculosDisponibles.Select(v => v.Combustible).Distinct().OrderBy(valor => valor),
        "Transmision" => VehiculosDisponibles.Select(v => v.Transmision).Distinct().OrderBy(valor => valor),
        "PrecioMaximo" => VehiculosDisponibles.Select(v => v.Precio)
            .Distinct().OrderBy(precio => precio)
            .Select(precio => precio.ToString(CultureInfo.InvariantCulture)),
        _ => Enumerable.Empty<string>()
    };

    protected override async Task OnInitializedAsync()
    {
        await Limpiar();
    }

    private async Task Limpiar()
    {
        Filtro = "Matricula";
        EstadoFiltro = "";
        ValorFiltro = "";
        AnoDesde = null;
        AnoHasta = null;
        Mensaje = null;
        var resultado = await VehiculoService.GetList(v => true);
        if (resultado.IsSuccess)
        {
            VehiculosDisponibles = resultado.Value;
            Vehiculos = VehiculosDisponibles;
        }
        else
        {
            VehiculosDisponibles = new();
            Vehiculos = new();
            Mensaje = resultado.Error.Description;
        }
    }

    private void LimpiarValorFiltro()
    {
        ValorFiltro = "";
    }

    private async Task Buscar()
    {
        Mensaje = null;
        if (AnoDesde.HasValue && AnoHasta.HasValue && AnoDesde.Value > AnoHasta.Value)
        {
            Vehiculos = new();
            Mensaje = "El año desde no puede ser posterior al año hasta.";
            return;
        }

        var valor = ValorFiltro.Trim();
        var estado = EstadoFiltro;
        var anoDesde = AnoDesde;
        var anoHasta = AnoHasta;
        var valorAno = int.TryParse(ValorFiltro, out var ano) ? ano : (int?)null;
        var valorPrecio = decimal.TryParse(
            ValorFiltro,
            NumberStyles.Number,
            CultureInfo.InvariantCulture,
            out var precio) ? precio : (decimal?)null;

        Expression<Func<Vehiculos, bool>> criterio = Filtro switch
        {
            "Matricula" => v =>
                (valor == "" || v.Matricula == valor) &&
                (estado == "" || v.Estado == estado) &&
                (!anoDesde.HasValue || v.Ano >= anoDesde.Value) &&
                (!anoHasta.HasValue || v.Ano <= anoHasta.Value),
            "Marca" => v =>
                (valor == "" || (v.Modelo != null && v.Modelo.Marca == valor)) &&
                (estado == "" || v.Estado == estado) &&
                (!anoDesde.HasValue || v.Ano >= anoDesde.Value) &&
                (!anoHasta.HasValue || v.Ano <= anoHasta.Value),
            "Modelo" => v =>
                (valor == "" || (v.Modelo != null && v.Modelo.Nombre == valor)) &&
                (estado == "" || v.Estado == estado) &&
                (!anoDesde.HasValue || v.Ano >= anoDesde.Value) &&
                (!anoHasta.HasValue || v.Ano <= anoHasta.Value),
            "Ano" => v =>
                (!valorAno.HasValue || v.Ano == valorAno.Value) &&
                (estado == "" || v.Estado == estado) &&
                (!anoDesde.HasValue || v.Ano >= anoDesde.Value) &&
                (!anoHasta.HasValue || v.Ano <= anoHasta.Value),
            "Color" => v =>
                (valor == "" || v.Color == valor) &&
                (estado == "" || v.Estado == estado) &&
                (!anoDesde.HasValue || v.Ano >= anoDesde.Value) &&
                (!anoHasta.HasValue || v.Ano <= anoHasta.Value),
            "Tipo" => v =>
                (valor == "" || v.Tipo == valor) &&
                (estado == "" || v.Estado == estado) &&
                (!anoDesde.HasValue || v.Ano >= anoDesde.Value) &&
                (!anoHasta.HasValue || v.Ano <= anoHasta.Value),
            "Combustible" => v =>
                (valor == "" || v.Combustible == valor) &&
                (estado == "" || v.Estado == estado) &&
                (!anoDesde.HasValue || v.Ano >= anoDesde.Value) &&
                (!anoHasta.HasValue || v.Ano <= anoHasta.Value),
            "Transmision" => v =>
                (valor == "" || v.Transmision == valor) &&
                (estado == "" || v.Estado == estado) &&
                (!anoDesde.HasValue || v.Ano >= anoDesde.Value) &&
                (!anoHasta.HasValue || v.Ano <= anoHasta.Value),
            "PrecioMaximo" => v =>
                (!valorPrecio.HasValue || v.Precio <= valorPrecio.Value) &&
                (estado == "" || v.Estado == estado) &&
                (!anoDesde.HasValue || v.Ano >= anoDesde.Value) &&
                (!anoHasta.HasValue || v.Ano <= anoHasta.Value),
            _ => v => false
        };

        var resultado = await VehiculoService.GetList(criterio);
        if (resultado.IsSuccess)
        {
            Vehiculos = resultado.Value;
        }
        else
        {
            Vehiculos = new();
            Mensaje = resultado.Error.Description;
        }
    }

    private static string EstadoClase(string estado) => estado switch
    {
        "Disponible" => "text-bg-success",
        "Reservado" => "text-bg-warning",
        "Inactivo" => "text-bg-secondary",
        "Vendido" => "text-bg-primary",
        _ => "text-bg-dark"
    };
}
