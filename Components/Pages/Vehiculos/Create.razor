@page "/Vehiculos/Create"

@rendermode InteractiveServer

@inject VehiculosServices VehiculoService
@inject ModelosServices ModeloService
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment

<PageTitle>Crear Vehículo</PageTitle>

<EditForm Model="@Vehiculo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header d-flex align-items-center py-2">
                <h5 class="mb-0">Crear Vehículo</h5>
            </div>

            <div class="card-body d-flex flex-column gap-4">
                @if (!string.IsNullOrEmpty(Mensaje))
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-exclamation-triangle"></i>
                        @Mensaje
                    </div>
                }

                <div class="row g-4">
                    <div class="col-lg-7 d-flex flex-column gap-3">
                        <h6 class="border-bottom pb-2 mb-0">Información del vehículo</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="marca" class="form-label"><strong>Marca</strong></label>
                                <InputSelect id="marca" class="form-select" @bind-Value="MarcaSeleccionada" @bind-Value:after="CambiarMarca">
                                    <option value="">Seleccione una marca</option>
                                    @foreach (var marca in Marcas)
                                    {
                                        <option value="@marca">@marca</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label for="modelo" class="form-label">
                                    <strong>Modelo</strong>
                                </label>
                                <InputSelect id="modelo" 
                                            class="form-select" 
                                            @bind-Value="Vehiculo.ModeloId">

                                    <option value="0">
                                        Seleccione un modelo
                                    </option>
                                    @foreach (var modelo in ModelosDeMarca)
                                    {
                                        <option value="@modelo.ModeloId">@modelo.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => Vehiculo.ModeloId)" />
                            </div>
                            <div class="col-md-4">
                                <label for="ano" class="form-label">
                                    <strong>Año</strong>
                                </label>
                                <InputNumber id="ano" 
                                            class="form-control" 
                                            @bind-Value="Vehiculo.Ano" />

                                <ValidationMessage For="@(() => Vehiculo.Ano)" />
                            </div>
                            <div class="col-md-4">
                                <label for="matricula" class="form-label">
                                    <strong>Matrícula</strong>
                                </label>
                                <InputText id="matricula" 
                                            class="form-control" 
                                            @bind-Value="Vehiculo.Matricula" />
                                <ValidationMessage For="@(() => Vehiculo.Matricula)" />
                            </div>
                            <div class="col-md-4">
                                <label for="color" class="form-label">
                                    <strong>Color</strong>
                                </label>
                                <InputText id="color" 
                                            class="form-control" 
                                            @bind-Value="Vehiculo.Color" />
                                <ValidationMessage For="@(() => Vehiculo.Color)" />
                            </div>
                            <div class="col-md-4">
                                <label for="precio" class="form-label">
                                    <strong>Precio</strong>
                                </label>
                                <InputNumber id="precio" 
                                            class="form-control" 
                                            @bind-Value="Vehiculo.Precio" />
                                <ValidationMessage For="@(() => Vehiculo.Precio)" />
                            </div>
                            <div class="col-md-4">
                                <label for="kilometraje" class="form-label">
                                    <strong>Kilometraje</strong>
                                </label>
                                <InputNumber id="kilometraje" 
                                            class="form-control" 
                                            @bind-Value="Vehiculo.Kilometraje" />
                                <ValidationMessage For="@(() => Vehiculo.Kilometraje)" />
                            </div>
                            <div class="col-md-4">
                                <label for="tipo" class="form-label">
                                    <strong>Tipo</strong>
                                </label>
                                <InputSelect id="tipo" class="form-select" @bind-Value="Vehiculo.Tipo">
                                    <option value="">
                                        Seleccione un tipo
                                    </option>
                                    <option value="Sedan">
                                        Sedan
                                    </option>
                                    <option value="SUV">
                                        SUV
                                    </option>
                                    <option value="Camioneta">
                                        Camioneta
                                    </option>
                                    <option value="Hatchback">
                                        Hatchback
                                    </option>
                                    <option value="Coupé">
                                        Coupé
                                    </option>
                                </InputSelect>
                                <ValidationMessage For="@(() => Vehiculo.Tipo)" />
                            </div>
                            <div class="col-md-6">
                                <label for="combustible" class="form-label">
                                    <strong>Combustible</strong>
                                </label>
                                <InputSelect id="combustible" class="form-select" @bind-Value="Vehiculo.Combustible">
                                    <option value="">
                                        Seleccione un combustible
                                    </option>
                                    <option value="Gasolina">
                                        Gasolina
                                    </option>
                                    <option value="Gas">
                                        Gas
                                    </option>
                                    <option value="Gas Oil">
                                        Gas Oil
                                    </option>
                                    <option value="Electrico">
                                        Eléctrico
                                    </option>
                                </InputSelect>
                                <ValidationMessage For="@(() => Vehiculo.Combustible)" />
                            </div>
                            <div class="col-md-6">
                                <label for="transmision" class="form-label">
                                    <strong>Transmisión</strong>
                                </label>
                                <InputSelect id="transmision" class="form-select" @bind-Value="Vehiculo.Transmision">
                                    <option value="">
                                        Seleccione una transmisión
                                    </option>
                                    <option value="Automatico">
                                        Automático
                                    </option>
                                    <option value="Manual">
                                        Manual
                                    </option>
                                    <option value="Hibrido">
                                        Híbrido
                                    </option>
                                </InputSelect>
                                <ValidationMessage For="@(() => Vehiculo.Transmision)" />
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5 d-flex flex-column gap-3">
                        <h6 class="border-bottom pb-2 mb-0">
                            Fotografía
                        </h6>
                        <label for="foto" class="form-label">
                            <strong>Seleccionar imagen</strong>
                        </label>
                        <InputFile id="foto" 
                                    class="form-control" 
                                    accept="image/*" 
                                    OnChange="CargarImagen" />
                        @if (!string.IsNullOrWhiteSpace(MensajeImagen))
                        {
                            <div class="alert alert-warning mb-0">@MensajeImagen</div>
                        }
                        <div class="ratio ratio-16x9 border rounded overflow-hidden">
                            @if (!string.IsNullOrWhiteSpace(Vehiculo.Foto))
                            {
                                <img src="@Vehiculo.Foto" alt="Vista previa del vehículo" class="w-100 h-100 object-fit-cover" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center text-secondary">
                                    <i class="bi bi-image fs-1"></i>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex gap-2">
                <button type="submit" 
                        class="btn btn-primary">
                    <i class="bi bi-plus"></i>
                    Crear
                </button>
                <a href="/Vehiculos/Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </a>
            </div>
        </div>
    </div>
</EditForm>

@code {
    private Vehiculos Vehiculo { get; set; } = new() { Ano = DateTime.Now.Year, Estado = "Disponible" };
    private List<Modelos> TodosModelos { get; set; } = new();
    private List<Modelos> ModelosDeMarca { get; set; } = new();
    private List<string> Marcas { get; set; } = new();
    private string MarcaSeleccionada { get; set; } = "";
    private string Mensaje { get; set; } = "";
    private string MensajeImagen { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        TodosModelos = (await ModeloService.GetList(m => m.Activo)).Value;
        Marcas = TodosModelos.Select(m => m.Marca).Distinct().OrderBy(m => m).ToList();
    }

    private void CambiarMarca()
    {
        Vehiculo.ModeloId = 0;
        ModelosDeMarca = TodosModelos
            .Where(m => string.Equals(m.Marca, MarcaSeleccionada, StringComparison.OrdinalIgnoreCase))
            .OrderBy(m => m.Nombre)
            .ToList();
    }

    private async Task CargarImagen(InputFileChangeEventArgs e)
    {
        MensajeImagen = "";
        var archivo = e.File;

        if (archivo.Size > 5 * 1024 * 1024)
        {
            MensajeImagen = "La imagen no puede superar 5 MB.";
            return;
        }

        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (extension is not ".jpg" and not ".jpeg" and not ".png" and not ".webp" and not ".avif")
        {
            MensajeImagen = "Seleccione una imagen JPG, PNG, WEBP o AVIF.";
            return;
        }

        var carpeta = Path.Combine(Environment.WebRootPath, "uploads", "vehiculos");
        Directory.CreateDirectory(carpeta);
        var nombre = $"{Guid.NewGuid():N}{extension}";
        var ruta = Path.Combine(carpeta, nombre);

        await using var origen = archivo.OpenReadStream(5 * 1024 * 1024);
        await using var destino = File.Create(ruta);
        await origen.CopyToAsync(destino);

        Vehiculo.Foto = $"/uploads/vehiculos/{nombre}";
    }

    private async Task Guardar()
    {
        Mensaje = "";
        Vehiculo.Matricula = Vehiculo.Matricula.Trim().ToUpperInvariant();

        if (Vehiculo.ModeloId == 0)
        {
            Mensaje = "Seleccione una marca y un modelo.";
            return;
        }

        if (await VehiculoService.ExisteMatricula(Vehiculo.Matricula))
        {
            Mensaje = "Ya existe un vehículo con esa matrícula.";
            return;
        }

        await VehiculoService.Guardar(Vehiculo);
        Navigation.NavigateTo("/Vehiculos/Index");
    }
}
