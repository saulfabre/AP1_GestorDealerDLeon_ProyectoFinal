@page "/Modelos/Delete/{ModeloId:int}"

@rendermode InteractiveServer

@inject ModelosServices ModeloService
@inject NavigationManager Navigation

<PageTitle>Eliminar Modelo</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex align-items-center py-2">
            <h5 class="mb-0">Eliminar Modelo</h5>
        </div>

        @if (Modelo is not null)
        {
            <div class="card-body d-flex flex-column gap-3">
                @if (Modelo.Vehiculos.Count > 0)
                {
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-exclamation-triangle"></i>
                        Este modelo tiene vehículos registrados y no se puede eliminar. Puede desactivarlo para que no aparezca en nuevos registros.
                    </div>
                }
                else
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-trash"></i>
                        ¿Seguro que desea eliminar este modelo?
                    </div>
                }

                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between border-bottom pb-1"><strong>ID</strong><span>@Modelo.ModeloId</span></div>
                    <div class="d-flex justify-content-between border-bottom pb-1"><strong>Marca</strong><span>@Modelo.Marca</span></div>
                    <div class="d-flex justify-content-between border-bottom pb-1"><strong>Modelo</strong><span>@Modelo.Nombre</span></div>
                    <div class="d-flex justify-content-between border-bottom pb-1"><strong>Vehículos</strong><span>@Modelo.Vehiculos.Count</span></div>
                    <div class="d-flex justify-content-between"><strong>Estado</strong><span>@(Modelo.Activo ? "Activo" : "Inactivo")</span></div>
                </div>
            </div>

            <div class="card-footer d-flex gap-2">
                @if (Modelo.Vehiculos.Count == 0)
                {
                    <button type="button" class="btn btn-danger" @onclick="Eliminar">
                        <i class="bi bi-trash"></i>
                        Eliminar
                    </button>
                }
                <button type="button" class="btn btn-outline-danger" @onclick="CambiarActivo">
                    <i class="bi bi-slash-circle"></i>
                    @(Modelo.Activo ? "Desactivar" : "Activar")
                </button>
                <a href="/Modelos/Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </a>
            </div>
        }
        else
        {
            <div class="card-body d-flex flex-column align-items-center gap-2">
                <p class="mb-0">El modelo no fue encontrado.</p>
                <a href="/Modelos/Index" class="btn btn-outline-secondary">Volver</a>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int ModeloId { get; set; }

    private Modelos? Modelo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Modelo = (await ModeloService.GetList(m => m.ModeloId == ModeloId)).Value.FirstOrDefault();
    }

    private async Task Eliminar()
    {
        if (Modelo is null || Modelo.Vehiculos.Count > 0)
        {
            return;
        }

        await ModeloService.Eliminar(Modelo.ModeloId);
        Navigation.NavigateTo("/Modelos/Index");
    }

    private async Task CambiarActivo()
    {
        if (Modelo is null)
        {
            return;
        }

        await ModeloService.CambiarActivo(Modelo.ModeloId, !Modelo.Activo);
        Navigation.NavigateTo("/Modelos/Index");
    }
}