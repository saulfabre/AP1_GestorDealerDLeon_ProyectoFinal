@page "/Modelos/Edit/{ModeloId:int}"

@rendermode InteractiveServer

@inject ModelosServices ModeloService
@inject NavigationManager Navigation

<PageTitle>Editar Modelo</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <h5 class="mb-0">Editar Modelo</h5>
            @if (Modelo is not null)
            {
                <span class="text-secondary">ID: @Modelo.ModeloId</span>
            }
        </div>

        @if (Modelo is not null)
        {
            <EditForm Model="@Modelo" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="card-body d-flex flex-column gap-3">
                    @if (!string.IsNullOrEmpty(Mensaje))
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-0">
                            <i class="bi bi-exclamation-triangle"></i>
                            @Mensaje
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-3">
                        <div class="d-flex flex-column flex-fill">
                            <label class="form-label"><strong>Marca</strong></label>
                            <InputText class="form-control" list="marcas" @bind-Value="Modelo.Marca" />
                            <datalist id="marcas">
                                @foreach (var marca in MarcasExistentes)
                                {
                                    <option value="@marca"></option>
                                }
                            </datalist>
                            <ValidationMessage For="@(() => Modelo.Marca)" />
                        </div>
                        <div class="d-flex flex-column flex-fill">
                            <label class="form-label"><strong>Modelo</strong></label>
                            <InputText class="form-control" @bind-Value="Modelo.Nombre" />
                            <ValidationMessage For="@(() => Modelo.Nombre)" />
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 form-check form-switch">
                        <InputCheckbox class="form-check-input" id="activo" @bind-Value="Modelo.Activo" />
                        <label class="form-check-label" for="activo">Activo</label>
                    </div>
                </div>

                <div class="card-footer d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-floppy"></i>
                        Guardar cambios
                    </button>
                    <a href="@($"/Modelos/Delete/{Modelo.ModeloId}")" class="btn btn-outline-danger">
                        <i class="bi bi-trash"></i>
                        Eliminar
                    </a>
                    <a href="/Modelos/Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i>
                        Volver
                    </a>
                </div>
            </EditForm>
        }
        else
        {
            <div class="card-body d-flex flex-column align-items-center gap-2">
                <p class="mb-0">El modelo no fue encontrado.</p>
                <a href="/Modelos/Index" class="btn btn-outline-secondary">Volver</a>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int ModeloId { get; set; }

    private Modelos? Modelo { get; set; }
    private List<string> MarcasExistentes { get; set; } = new();
    private string Mensaje { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        Modelo = (await ModeloService.Buscar(ModeloId)).Value;

        MarcasExistentes = (await ModeloService.GetList(m => true)).Value
            .Select(m => m.Marca)
            .Distinct()
            .OrderBy(m => m)
            .ToList();
    }

    private async Task Guardar()
    {
        if (Modelo is null)
        {
            return;
        }

        Mensaje = "";
        Modelo.Marca = Modelo.Marca.Trim();
        Modelo.Nombre = Modelo.Nombre.Trim();

        if (await ModeloService.ExisteNombre(Modelo.Marca, Modelo.Nombre, Modelo.ModeloId))
        {
            Mensaje = "Ya existe otro modelo igual para esa marca.";
            return;
        }

        await ModeloService.Guardar(Modelo);
        Navigation.NavigateTo("/Modelos/Index");
    }
}
