@page "/"
@layout Layout.LandingLayout

<PageTitle>D'Leon & Asociados | Inicio</PageTitle>

<div class="landing-page">
    <header class="landing-header">
        <a class="landing-brand" href="/" aria-label="D'Leon & Asociados, inicio">
            <span class="landing-brand-name">D'LEON</span>
            <span class="landing-brand-subtitle">&amp; ASOCIADOS S.R.L.</span>
        </a>

        <nav class="landing-nav" aria-label="Navegación principal">
            <a class="landing-nav-link active" href="/">Inicio</a>
            <a class="landing-nav-link" href="/Vehiculos/Index">Vehículos</a>
        </nav>

        <a class="landing-access" href="/Vehiculos/Index">Acceso</a>
    </header>

    <main class="landing-hero">
        <img class="landing-hero-image"
             src="/images/Inicio/Gemini_Generated_Gif_hu8rrehu8rrehu8r.gif"
             alt="Vehículo de D'Leon & Asociados" />
        <div class="landing-hero-content">
            <p class="landing-eyebrow">D'LEON &amp; ASOCIADOS</p>
            <h1>D'LEON<br />ASOCIADOS</h1>
            <p class="landing-description">
                Disfruta de la facilidad de encontrar y adquirir el vehículo perfecto.
            </p>
            <a class="landing-cta" href="/Vehiculos/Index">Ver vehículos</a>
        </div>
    </main>
</div>
