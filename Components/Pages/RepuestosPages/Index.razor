@page "/Repuestos/Index"

@rendermode InteractiveServer

@inject RepuestosServices RepuestoService

<PageTitle>Index</PageTitle>

@*Encabezado de la consulta de repuestos*@
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center" style="height: 50px;">
            <h5 class="mb-0">Consulta de Repuestos</h5>

            @*Botón para crear un nuevo repuesto*@
            <a href="/Repuestos/Create" class="btn btn-primary">
                <i class="bi bi-plus"></i>
                Crear
            </a>
        </div>

        @*Cuerpo de la consulta de repuestos*@
        <div class="card-body">
            <div class="d-flex align-items-center gap-4">
                @*Filtrar por*@
                <div>
                    <label class="form-label"><strong>Filtrar por</strong></label>
                    <select class="form-select" @bind="Filtro">
                        <option value="Id">Id</option>
                        <option value="Nombre">Nombre</option>
                        <option value="Marca">Marca</option>
                        <option value="Categoria">Categoría</option>
                    </select>
                </div>

                @*Búsqueda*@
                <div>
                    <label class="form-label"><strong>Búsqueda</strong></label>

                    <div class="d-flex gap-2">
                        <input type="text" class="form-control" placeholder="Buscar..." @bind="ValorFiltro" />

                        @*Botón Buscar*@
                        <button class="btn btn-outline-primary" @onclick="Buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            @*Tabla para consultar información de repuestos*@
            <QuickGrid Items="@Repuestos.AsQueryable()" Class="table table-bordered mt-3 align-middle">
                <PropertyColumn Property="@(r => r.RepuestoId)" Title="ID" Sortable="true" />
                <PropertyColumn Property="@(r => r.Nombre)" Title="Nombre" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="@(r => r.Descripcion)" Title="Descripción" Sortable="true" />
                <PropertyColumn Property="@(r => r.Marca)" Title="Marca" Sortable="true" />
                <PropertyColumn Property="@(r => r.Categoria)" Title="Categoría" Sortable="true" />
                <PropertyColumn Property="@(r => r.PrecioVenta)" Title="Precio de Venta" Sortable="true" />
                <PropertyColumn Property="@(r => r.Existencia)" Title="Existencia" Sortable="true" />

                @*Estados*@
                <TemplateColumn Title="Estado">
                    @if (context.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </TemplateColumn>

                @*Opciones*@
                <TemplateColumn Title="Opciones">
                    <div class="d-flex gap-2">
                        <a href="@($"/Repuestos/Edit/{context.RepuestoId}")" class="btn btn-warning">Editar</a>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>

        @*Footer*@
        <div class="card-footer">
            <p class="mb-0"><strong>Cantidad: </strong>@Repuestos.Count</p>
        </div>
    </div>
</div>

@code
{
    public List<Repuestos> Repuestos { get; set; } = new();

    public string Filtro = "Id";
    public string ValorFiltro = "";

    protected override async Task OnInitializedAsync()
    {
        Repuestos = (await RepuestoService.GetList(r => true)).Value;
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Id" && int.TryParse(ValorFiltro, out int repuestoId))
            {
                Repuestos = (await RepuestoService.GetList(r => r.RepuestoId == repuestoId)).Value;
            }
            else if (Filtro == "Nombre")
            {
                Repuestos = (await RepuestoService.GetList(r => r.Nombre.ToLower().Contains(ValorFiltro.ToLower()))).Value;
            }
            else if (Filtro == "Marca")
            {
                Repuestos = (await RepuestoService.GetList(r => r.Marca.ToLower().Contains(ValorFiltro.ToLower()))).Value;
            }
            else if (Filtro == "Categoria")
            {
                Repuestos = (await RepuestoService.GetList(r => r.Categoria.ToLower().Contains(ValorFiltro.ToLower()))).Value;
            }
        }
        else
        {
            Repuestos = (await RepuestoService.GetList(r => true)).Value;
        }
    }
}
