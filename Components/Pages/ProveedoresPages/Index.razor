@page "/Proveedores/Index"

@rendermode InteractiveServer

@inject ProveedoresServices ProveedorService

<PageTitle>Index</PageTitle>

@*Encabezado de la consulta de proveedores*@
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center" style="height: 50px;">
            <h5 class="mb-0">Consulta de Proveedores</h5>

            @*Bóton para crear un nuevo proveedor*@
            <a href="/Proveedores/Create" class="btn btn-primary">
                <i class="bi bi-plus"></i>
                Crear
            </a>
        </div>

        @*Cuerpo de la consulta de proveedores*@
        <div class="card-body">
            <div class="d-flex align-items-center gap-4">
                @*Filtrar por*@
                <div>
                    <label class="form-label"><strong>Filtrar por</strong></label>
                    <select class="form-select" @bind="Filtro">
                        <option value="Id">Id</option>
                        <option value="Nombre">Nombre</option>
                        <option value="RNC">RNC</option>
                        <option value="Telefono">Teléfono</option>
                        <option value="Correo">Correo</option>
                        <option value="Direccion">Dirección</option>
                    </select>
                </div>

                @*Búsqueda*@
                <div>
                    <label class="form-label"><strong>Búsqueda</strong></label>

                    <div class="d-flex gap-2">
                        <input type="text" class="form-control" placeholder="Buscar..." @bind="ValorFiltro" />

                        @*Botón Buscar*@
                        <button class="btn btn-outline-primary" @onclick="Buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            @*Tabla para consultar información de proveedores*@
            <QuickGrid Items="@Proveedores.AsQueryable()" Class="table table-bordered mt-3 align-middle">
                <PropertyColumn Property="@(p => p.ProveedorId)" Title="ID" Sortable="true" />
                <PropertyColumn Property="@(p => p.Nombre)" Title="Nombre" Sortable="true" />
                <PropertyColumn Property="@(p => p.RNC)" Title="RNC" Sortable="true" />
                <PropertyColumn Property="@(p => p.Telefono)" Title="Teléfono" Sortable="true" />
                <PropertyColumn Property="@(p => p.Correo)" Title="Correo" Sortable="true" />
                <PropertyColumn Property="@(p => p.Direccion)" Title="Dirección" Sortable="true" />

                @*Estados*@
                <TemplateColumn Title="Estado">
                    @if (context.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </TemplateColumn>

                @*Opciones*@
                <TemplateColumn Title="Opciones">
                    <div class="d-flex gap-2">
                        <a href="@($"/Proveedores/Edit/{context.ProveedorId}")" class="btn btn-warning">Editar</a>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>

        @*Footer*@
        <div class="card-footer">
            <p class="mb-0"><strong>Cantidad: </strong>@Proveedores.Count</p>
        </div>
    </div>
</div>

@code
{
    public List<Proveedores> Proveedores { get; set; } = new();

    public string Filtro = "Id";
    public string ValorFiltro = "";

    protected override async Task OnInitializedAsync()
    {
        Proveedores = (await ProveedorService.GetList(p => true)).Value;
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Id" && int.TryParse(ValorFiltro, out int proveedorId))
            {
                Proveedores = (await ProveedorService.GetList(p => p.ProveedorId == proveedorId)).Value;
            }
            else if (Filtro == "Nombre")
            {
                Proveedores = (await ProveedorService.GetList(p => p.Nombre.ToLower().Contains(ValorFiltro.ToLower()))).Value;
            }
            else if (Filtro == "RNC")
            {
                Proveedores = (await ProveedorService.GetList(p => p.RNC.ToLower().Contains(ValorFiltro.ToLower()))).Value;
            }
            else if (Filtro == "Telefono")
            {
                Proveedores = (await ProveedorService.GetList(p => p.Telefono.ToLower().Contains(ValorFiltro.ToLower()))).Value;
            }
            else if (Filtro == "Correo")
            {
                Proveedores = (await ProveedorService.GetList(p => p.Correo.ToLower().Contains(ValorFiltro.ToLower()))).Value;
            }
            else if (Filtro == "Direccion")
            {
                Proveedores = (await ProveedorService.GetList(p => p.Direccion.ToLower().Contains(ValorFiltro.ToLower()))).Value;
            }
        }
        else
        {
            Proveedores = (await ProveedorService.GetList(p => true)).Value;
        }
    }
}
