@page "/Proveedores/Edit/{ProveedorId:int}"

@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject ProveedoresServices ProveedorService

<PageTitle>Editar Proveedor</PageTitle>

@if (Proveedor != null)
{
    <EditForm Model="Proveedor" OnValidSubmit="Editar">

        <DataAnnotationsValidator />

        @*Encabezado de la edición de proveedores*@
        <div class="container">
            <div class="card shadow-lg">
                <div class="card-header d-flex align-items-center" style="height: 50px;">
                    <h5 class="mb-0">Editar Proveedor</h5>
                </div>

                @*Formulario para la edición de un proveedor*@
                <div class="card-body">
                    <div class="d-flex flex-column gap-2">

                        @*Nombre*@
                        <label class="form-label mb-0">
                            <strong>Nombre</strong>
                        </label>
                        <InputText class="form-control" @bind-Value="Proveedor.Nombre" placeholder="Ej: Auto Repuestos XYZ"></InputText>
                        <ValidationMessage For="@(() => Proveedor.Nombre)" />

                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                @*RNC*@
                                <label class="form-label mb-0">
                                    <strong>RNC</strong>
                                </label>
                                <InputText class="form-control" @bind-Value="Proveedor.RNC" placeholder="Ej: 000-00000-0"></InputText>
                                <ValidationMessage For="@(() => Proveedor.RNC)" />
                            </div>

                            <div class="flex-fill">
                                @*Teléfono*@
                                <label class="form-label mb-0">
                                    <strong>Teléfono</strong>
                                </label>
                                <InputText class="form-control" @bind-Value="Proveedor.Telefono" placeholder="Ej: 809-000-0000"></InputText>
                                <ValidationMessage For="@(() => Proveedor.Telefono)" />
                            </div>
                        </div>

                        @*Correo*@
                        <label class="form-label mb-0">
                            <strong>Correo</strong>
                        </label>
                        <InputText class="form-control" @bind-Value="Proveedor.Correo" placeholder="Ej: proveedor@gmail.com"></InputText>
                        <ValidationMessage For="@(() => Proveedor.Correo)" />

                        @*Dirección*@
                        <label class="form-label mb-0">
                            <strong>Dirección</strong>
                        </label>
                        <InputText class="form-control" @bind-Value="Proveedor.Direccion" placeholder="Ej: Calle Principal #123"></InputText>
                        <ValidationMessage For="@(() => Proveedor.Direccion)" />

                        @*Estado*@
                        <div class="form-check mt-2">
                            <InputCheckbox class="form-check-input" @bind-Value="Proveedor.Activo" />
                            <label class="form-check-label"><strong>Activo</strong></label>
                        </div>
                    </div>
                </div>

                @*Botón Editar*@
                <div class="card-footer d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        Editar
                    </button>

                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#exampleModal">
                        Eliminar
                    </button>

                    @*Botón Volver*@
                    <a href="/Proveedores/Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i>
                        Volver
                    </a>
                </div>
            </div>
        </div>
    </EditForm>

    @*Modal*@
    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    ¿Desea la eliminación de este proveedor?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cerrar
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="Eliminar">
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p>Proveedor no encontrado</p>
}

@code
{
    [Parameter]
    public int ProveedorId { get; set; } = new();

    public Proveedores? Proveedor { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Proveedor = (await ProveedorService.Buscar(ProveedorId)).Value;
    }

    private async Task Editar()
    {
        if (Proveedor == null)
        {
            return;
        }

        await ProveedorService.Guardar(Proveedor);
        Navigation.NavigateTo("/Proveedores/Index");
    }

    private async Task Eliminar()
    {
        if (Proveedor == null)
        {
            return;
        }

        await ProveedorService.Eliminar(Proveedor.ProveedorId);
        Navigation.NavigateTo("/Proveedores/Index");
    }
}
